# Production (Vercel): Settings > Environment Variables.
# Server-side key used by /api/news — stays secret, never shipped to the browser.
GNEWS_API_KEY=your_gnews_api_key_here

# Local dev only: `npm run dev` serves no serverless functions, so the app
# calls GNews directly (localhost origin is allowed). Production ignores this.
VITE_GNEWS_API_KEY=your_gnews_api_key_here
